root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,json,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
indent_size = 4

# Always use braces, even for a single statement. A brace-less `if` compiles
# happily when a second line is added under it, and that line then runs
# unconditionally. In software where a missed branch means a missed alert,
# that is a safety rule rather than a style preference.
csharp_prefer_braces = true:error
dotnet_diagnostic.IDE0011.severity = error

# Conventions this codebase already follows.
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_using_directive_placement = outside_namespace:suggestion
dotnet_sort_system_directives_first = true

# EF Core writes these files, not us. They arrive with a UTF-8 BOM and their
# own formatting, and the next `dotnet ef migrations add` would undo anything
# we changed by hand. Marking them generated stops the analyzers reporting
# style rules against code nobody wrote.
[src/ElderSafe.Api/Migrations/*.cs]
generated_code = true
