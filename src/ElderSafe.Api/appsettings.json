{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ElderSafe": "Data Source=eldersafe.db"
  },
  "FallDetection": {
    "FreeFallThresholdG": 0.6,
    "ImpactThresholdG": 2.5,
    "MaxTimeFromFreeFallToImpact": "00:00:01",
    "SettleAfterImpact": "00:00:00.5",
    "StillnessDuration": "00:00:02",
    "StillnessToleranceG": 0.25
  },
  "Escalation": {
    "ResponseTimeout": "00:02:00"
  },
  "Alerting": {
    "DetectionWindow": "00:00:04",
    "EscalationSweepInterval": "00:00:10"
  },
  "Simulation": {
    "Enabled": false
  },
  "DemoData": {
    "Enabled": false
  }
}
