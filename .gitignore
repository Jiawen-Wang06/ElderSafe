# dotnet publish output, and the zip made from it for manual Azure deploys.
publish/
*.zip

# The dashboard is built into the API's wwwroot by CI. Committing build
# output means every UI change arrives as a large unreadable diff.
src/ElderSafe.Api/wwwroot/

# The local SQLite database, created on first run by MigrateAsync and filled
# by the demo seeder. Developer scratch state, not a fixture: a committed copy
# would be stale on arrival and would carry whatever has been typed into it.
*.db
*.db-shm
*.db-wal

# Node / React
node_modules/
dist/
build/
.vite/
npm-debug.log*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# Datasets downloaded for model training; record their source in docs/06-soup.md.
# Anchored to the repository root and named so it cannot collide with a source
# folder: git sets core.ignorecase=true on Windows, so a bare `data/` also
# matched `src/ElderSafe.Api/Data/` and silently kept it out of the repository.
/datasets/
*.csv.zip
# Commit trained model files only when a release needs them, with their metrics:
# !models/*.onnx

# Environment and secrets
.env
.env.*
!.env.example
*.pfx
*.pem
local.settings.json

# appsettings.Development.json is deliberately NOT ignored. It holds no
# secrets, only the switches that make a fresh clone demonstrable: demo data
# and the simulator. Both stay off in appsettings.json so a deployed instance
# cannot invent residents or accept fabricated readings (RISK-15). Anything
# actually secret belongs in user secrets or environment variables.

# Infrastructure
*.bicepparam.local
